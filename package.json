{
  "name": "concord",
  "version": "0.2.1",
  "private": true,
  "author": "Concord",
  "license": "UNLICENSED",
  "description": "Compartilhamento pessoal de tela entre dois PCs",
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable --x64",
    "build:audio": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-audio.ps1",
    "test": "node --test tests/server.test.mjs tests/stream-settings.test.mjs tests/invites.test.mjs",
    "test:desktop": "node tests/desktop.mjs"
  },
  "dependencies": { "ws": "8.22.0" },
  "devDependencies": { "electron": "44.5.1", "electron-builder": "26.15.3" },
  "build": {
    "appId": "local.concord.desktop",
    "productName": "Concord",
    "directories": { "output": "dist/0.2.1" },
    "files": ["desktop/**/*", "public/**/*", "server.mjs", "package.json"],
    "extraResources": [
      { "from": ".runtime/cloudflared.exe", "to": "cloudflared.exe" },
      { "from": ".runtime/cloudflared-version.json", "to": "cloudflared-version.json" },
      { "from": ".runtime/ConcordAudio.exe", "to": "ConcordAudio.exe" }
    ],
    "win": { "target": "portable", "signExecutable": false, "icon": "desktop/icon.ico" },
    "portable": { "artifactName": "Concord-${version}-Windows.exe" }
  }
}
