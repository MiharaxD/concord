{
  "name": "concord",
  "version": "0.3.4",
  "private": true,
  "author": "Concord",
  "license": "UNLICENSED",
  "description": "Compartilhamento de tela e audio em salas privadas",
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -Target portable",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -Target installer",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -Target installer -Publish",
    "build:audio": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-audio.ps1",
    "test": "node --test tests/server.test.mjs tests/stream-settings.test.mjs tests/invites.test.mjs tests/updater-controller.test.cjs",
    "test:desktop": "node tests/call.mjs",
    "test:installer": "node tests/installer.mjs",
    "test:updater": "node tests/updater.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "playwright": "1.62.1"
  }
}
